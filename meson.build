project('lcos-notes', 'cpp', version: '0.8.0', meson_version: '>=0.56', license: 'Apache-2.0', default_options: ['cpp_std=c++17', 'warning_level=2'])
gtkmm = dependency('gtkmm-3.0', version: '>=3.24')
sourceview = dependency('gtksourceviewmm-3.0', version: '>=3.18')
glib = dependency('glib-2.0')
cmark = dependency('libcmark-gfm', version: '>=0.29.0')
core = static_library('notes-core', ['src/core.cpp', 'src/render.cpp'], dependencies: [glib, cmark])
executable('lcos-notes-cli', 'src/cli.cpp', link_with: core, dependencies: [glib, cmark], install: true)
executable('lcos-notes', 'src/gui.cpp', link_with: core, dependencies: [gtkmm, sourceview, cmark], install: true)
install_data('data/com.leebase.LcosNotes.desktop', install_dir: get_option('datadir') / 'applications')
install_data('data/com.leebase.LcosNotes.metainfo.xml', install_dir: get_option('datadir') / 'metainfo')
install_data('data/com.leebase.LcosNotes.svg', install_dir: get_option('datadir') / 'icons/hicolor/scalable/apps')
install_data(['data/lcos-notes.1', 'data/lcos-notes-cli.1'], install_dir: get_option('mandir') / 'man1')
